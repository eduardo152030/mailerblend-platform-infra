[Unit]
Description=Read-only functional health for existing LXC applications (D057)
After=docker.service
[Service]
Type=oneshot
User=root
Environment=DOCKER_CONFIG=/nonexistent
ExecStart=/usr/bin/python3 /opt/monitoring-functional/check.py --config /opt/monitoring-functional/config.json
TimeoutStartSec=25
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
