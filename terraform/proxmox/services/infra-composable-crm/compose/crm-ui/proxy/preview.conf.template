server {
    listen 443 ssl;
    server_name ${CRM_UI_PREVIEW_HOST};

    ssl_certificate ${CRM_UI_PREVIEW_CERT};
    ssl_certificate_key ${CRM_UI_PREVIEW_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    auth_basic "CRM UI preview";
    auth_basic_user_file ${CRM_UI_PREVIEW_USERS};

    location / {
        proxy_pass http://127.0.0.1:18089;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }
}
