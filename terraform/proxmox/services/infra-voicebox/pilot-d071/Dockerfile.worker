FROM python:3.10-slim-bookworm@sha256:5be5aaecb962a41567bc8041f1e9e3432cb085b037fe057f9a562630b2e4b370
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 MKL_NUM_THREADS=2 NUMBA_CACHE_DIR=/tmp/numba HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 PYTHONPATH=/src/openvoice:/src/melo
RUN apt-get update && apt-get install -y --no-install-recommends libsndfile1 ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.2.2+cpu torchaudio==2.2.2+cpu --index-url https://pypi.org/simple --extra-index-url https://download.pytorch.org/whl/cpu
COPY requirements-worker.txt /build/requirements-worker.txt
RUN pip install --no-cache-dir -r /build/requirements-worker.txt
COPY source-lock.json prepare-source.py /build/
RUN python /build/prepare-source.py
COPY controller.py infer.py /worker/
RUN pip freeze > /worker/requirements-observed.txt && useradd -u 999 -m worker
USER 999:999
WORKDIR /worker
CMD ["uvicorn", "controller:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--no-access-log"]
