[Unit]
Description=Voicebox Qwen supervisor dedicated to CT627
After=pve-guests.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/voicebox-qwen-627/agent.py
ExecStopPost=/usr/bin/python3 /opt/voicebox-qwen-627/agent.py --cleanup-owned
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=mixed
UMask=0077
MemoryMax=256M

[Install]
WantedBy=multi-user.target
