{{ define "telegram.message" }}
{{ if eq .Status "firing" }}🔴 <b>FIRING</b>{{ else }}🟢 <b>RESOLVED</b>{{ end }}
{{ range $i, $a := .Alerts }}{{ if lt $i 4 }}
<b>{{ $a.Labels.severity | toUpper }} · {{ $a.Labels.service }}</b>
{{ if $a.Annotations.ct_id }}CT {{ $a.Annotations.ct_id }} · {{ end }}{{ if $a.Labels.name }}{{ $a.Labels.name }}{{ end }}
{{ $a.Annotations.summary }}
{{ $a.Annotations.description }}
{{ if $a.Annotations.value }}Valor: {{ $a.Annotations.value }}{{ end }}{{ if $a.Annotations.threshold }} · Umbral: {{ $a.Annotations.threshold }}{{ end }}
Inicio: {{ $a.StartsAt | tz "Europe/Madrid" | date "02/01 15:04:05 MST" }}
{{ if eq $a.Status "resolved" }}Fin: {{ $a.EndsAt | tz "Europe/Madrid" | date "02/01 15:04:05 MST" }} · Duración: {{ $a.EndsAt.Sub $a.StartsAt | humanizeDuration }}{{ end }}
{{ if $a.Annotations.dashboard_url }}<a href="{{ $a.Annotations.dashboard_url }}">Ver monitorización</a>{{ end }}
{{ end }}{{ end }}
{{ if gt (len .Alerts) 4 }}Grupo: {{ len .Alerts }} alertas; se muestran 4.{{ end }}
{{ end }}
