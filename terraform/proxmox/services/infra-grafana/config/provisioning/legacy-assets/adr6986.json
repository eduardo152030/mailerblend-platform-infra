        "showHeader": true
      },
      "pluginVersion": "12.3.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "cfbd97mwbkx6ob"
          },
          "editorMode": "code",
          "format": 1,
          "location": "",
          "project": "nt-serverside-analytics",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  CASE \r\n    WHEN user_agent LIKE '%Windows%' THEN 'Windows'\r\n    WHEN user_agent LIKE '%Android%' THEN 'Android'\r\n    WHEN user_agent LIKE '%iPhone%' THEN 'iPhone'\r\n    WHEN user_agent LIKE '%Macintosh%' THEN 'Mac'\r\n    ELSE 'Otros'\r\n  END AS metric,\r\n  count(*) AS value\r\nFROM `nt-serverside-analytics.analytics_raw.v_analytics_ready`\r\nWHERE $__timeFilter(event_time)\r\n  AND user_agent NOT LIKE '%Blackbox%'\r\nGROUP BY 1",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Distribución por Sistema Operativo",
      "type": "table"
    },
