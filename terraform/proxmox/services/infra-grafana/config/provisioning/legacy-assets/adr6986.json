      },
      "description": "\"Este panel segmenta las visitas de usuarios reales según su sistema operativo, utilizando el análisis del User Agent capturado en el servidor. A diferencia de las herramientas convencionales, este gráfico ofrece una visibilidad total del entorno tecnológico del usuario, eliminando el ruido de bots y sistemas de monitoreo para reflejar fielmente la cuota de mercado entre dispositivos móviles (iOS/Android) y escritorio (Windows/Mac)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "hideFrom": {
              "viz": false
            },
