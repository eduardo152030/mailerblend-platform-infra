        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * container_memory_working_set_bytes{job=\"cadvisor\", instance=~\"$instance\", id=~\"$container\", id=~\".*docker-.*\"} / container_spec_memory_limit_bytes{job=\"cadvisor\", instance=~\"$instance\", id=~\"$container\", id=~\".*docker-.*\"}",
          "refId": "A",
          "instant": false,
          "range": true,
          "legendFormat": "{{id}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
