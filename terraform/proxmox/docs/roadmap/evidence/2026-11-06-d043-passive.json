      "relevant_proxy_directives": [
        "listen 80;",
        "server_name edge.nucleotecnologico.es;",
        "listen 443 ssl http2;",
        "server_name edge.nucleotecnologico.es;",
        "proxy_read_timeout     60s;",
        "proxy_set_header Host              $host;",
        "proxy_set_header X-Real-IP         $remote_addr;",
        "proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;",
        "proxy_set_header X-Forwarded-Proto $scheme;",
        "location ^~ /preview/ {",
        "rewrite ^/preview/(.*)$ /$1 break;",
        "proxy_pass http://192.168.1.114:8092;",
        "location = /preview {",
        "location = /orbit/healthz {",
        "proxy_pass http://192.168.1.117:18088/healthz;",
        "access_log /var/log/nginx/access.log sgtm;",
        "location = /orbit/ingest {",
        "proxy_pass http://192.168.1.117:18088/ingest;",
        "access_log /var/log/nginx/access.log sgtm;",
        "location / {",
        "proxy_pass http://192.168.1.114:8091;"
      ],
